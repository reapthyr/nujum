{
  "name": "@nujum/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Prisma schema, zod contracts, types, constants and permission definitions for Nujum",
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "default": "./dist/prisma.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./hmac": {
      "types": "./dist/hmac.d.ts",
      "default": "./dist/hmac.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit.d.ts",
      "default": "./dist/rate-limit.js"
    },
    "./zod": {
      "types": "./dist/zod/index.d.ts",
      "default": "./dist/zod/index.js"
    },
    "./prisma/schema": "./prisma/schema.prisma"
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "pg": "^8.16.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.1",
    "prisma": "6.8.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
