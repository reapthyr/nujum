# ── Database (Neon / Supabase) ───────────────────────────────────────────────
# Pooled connection string (PgBouncer) — used by the bot runtime and by Vercel.
# Neon example: postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/nujum?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://nujum:password@localhost:5432/nujum?schema=public"

# Direct (non-pooled) connection — ONLY for migrations and prisma studio.
DIRECT_URL="postgresql://nujum:password@localhost:5432/nujum?schema=public"

# ── Bot API (shared by apps/bot and apps/dashboard) ─────────────────────────
# 32+ bytes of cryptographically random data, e.g. `openssl rand -hex 32`.
BOT_API_HMAC_SECRET="replace-with-a-64-char-hex-secret"
# Optional previous secret during rotation (accepted for 10 minutes).
BOT_API_HMAC_SECRET_PREVIOUS=""
