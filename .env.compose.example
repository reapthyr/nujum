# Compose-level settings (no secrets here).
# Copy to .env.compose and use: docker compose --env-file .env.compose up -d
#
# Discord/API secrets belong in apps/bot/.env, which compose loads via env_file.

# Public hostname that Caddy serves and obtains a certificate for.
BOT_API_DOMAIN=api.nujum.app

# Let's Encrypt contact address.
ACME_EMAIL=admin@nujum.app
