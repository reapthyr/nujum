{
  "name": "@nujum/bot",
  "version": "0.2.0",
  "private": true,
  "description": "Nujum Discord bot — discord.js v14 + Fastify health/API server",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:sharded": "node dist/shard.js",
    "deploy:commands": "tsx src/scripts/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@nujum/shared": "workspace:*",
    "discord.js": "^14.16.3",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.0",
    "pino": "^9.6.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
