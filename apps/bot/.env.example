# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token.
# NEVER commit this value. The bot refuses to start if it is missing or too short.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register slash commands in this guild instantly during development.
DEV_GUILD_ID=

# Comma-separated Discord user IDs with global Nujum owner powers (/admin in the dashboard).
OWNER_IDS=

# ── Database (Neon/Supabase) ───────────────────────────────────────────────
# Pooled URL at runtime. The bot does not connect at boot in Phase 2, but the
# variable is required so production deployments cannot silently run without a DB.
DATABASE_URL=postgresql://nujum:password@localhost:5432/nujum?schema=public
DIRECT_URL=postgresql://nujum:password@localhost:5432/nujum?schema=public

# ── Internal Bot API ───────────────────────────────────────────────────────
# Bind to 127.0.0.1 locally; use 0.0.0.0 inside Docker (Caddy is the only exposed service).
BOT_API_HOST=127.0.0.1
BOT_API_PORT=8080
# 32+ random bytes: openssl rand -hex 32
BOT_API_HMAC_SECRET=
# Optional, accepted for 10 minutes during rotation.
BOT_API_HMAC_SECRET_PREVIOUS=
# Optional comma-separated CIDRs. Empty = allow any IP with a valid signature.
BOT_API_IP_ALLOWLIST=
# Trust X-Forwarded-For from a reverse proxy. Enable only behind Caddy/nginx with
# the bot port unpublished, otherwise clients can spoof their IP for the allowlist.
BOT_API_TRUST_PROXY=false

# ── Sharding ───────────────────────────────────────────────────────────────
# 1 = single process (development). >1 requires a compiled build (`pnpm build`).
SHARD_COUNT=1
# Optional comma-separated shard ids for this process (advanced/manual sharding).
SHARD_IDS=

# ── Presence / branding ────────────────────────────────────────────────────
BOT_STATUS=online
BOT_ACTIVITY=Nujum • /help
SUPPORT_SERVER_URL=https://discord.gg/nujum
# Optional override for the invite permission bitfield (decimal). Defaults to the
# union of permissions required by registered commands, never Administrator.
# INVITE_PERMISSIONS=
