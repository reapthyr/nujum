# ── Runtime (Vercel) ────────────────────────────────────────────────────────
NODE_ENV=production

# ── Database (Neon/Supabase) ────────────────────────────────────────────────
# Pooled URL for all runtime queries. DIRECT_URL is optional here; migrations
# are run from packages/shared, and the bot's config LISTEN uses the direct URL.
DATABASE_URL=postgresql://nujum:password@pool.example.com:5432/nujum?schema=public
DIRECT_URL=postgresql://nujum:password@direct.example.com:5432/nujum?schema=public

# ── Auth.js v5 ──────────────────────────────────────────────────────────────
# openssl rand -base64 48
AUTH_SECRET=
# Discord application ID and secret (OAuth2). Scopes are exactly: identify guilds
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Optional explicit Auth.js URL. Defaults to NEXT_PUBLIC_APP_URL.
AUTH_URL=
# Public origin used by the CSRF/origin guard (no trailing slash).
NEXT_PUBLIC_APP_URL=https://dashboard.example.com

# ── Internal Bot API ────────────────────────────────────────────────────────
# Public HTTPS origin of Caddy in front of the bot.
BOT_API_URL=https://api.example.com
# Must match the bot's BOT_API_HMAC_SECRET. openssl rand -hex 32
BOT_API_HMAC_SECRET=
# Optional previous secret, accepted during a 10-minute rotation window.
BOT_API_HMAC_SECRET_PREVIOUS=

# ── Authorization / sessions ────────────────────────────────────────────────
# Super-admins bypass Discord ownership checks. Exact snowflakes, comma separated.
DASHBOARD_OWNER_IDS=
SESSION_MAX_AGE_SECONDS=28800
SESSION_UPDATE_AGE_SECONDS=900
# Sensitive actions require a Discord identity check within this window.
REAUTH_WINDOW_MINUTES=15
DASHBOARD_RATE_LIMIT=120

# NEVER define a NEXT_PUBLIC_* variable whose name contains SECRET, TOKEN,
# PASSWORD, DATABASE_URL, DIRECT_URL, HMAC or API_KEY. The build fails on purpose.
